{
  "name": "climate-saarthi-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Climate Saarthi API — Express modular monolith (JavaScript, ESM)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:engine": "vitest run tests/engine",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest",
    "engine:example": "node scripts/engine-worked-example.js",
    "create-admin": "node scripts/create-admin.js",
    "dev:memory": "node --watch src/server.js --memory"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
